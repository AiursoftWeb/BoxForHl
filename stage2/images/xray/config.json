{
    "log": {
        "loglevel": "warning"
    },
    "inbounds": [
        {
            "tag": "http",
            "port": 10809,
            "listen": "0.0.0.0",
            "protocol": "http"
        },
        {
            "tag": "socks",
            "port": 10808,
            "listen": "0.0.0.0",
            "protocol": "socks",
            "settings": {
                "auth": "noauth"
            }
        }
    ],
    "outbounds": [
        {
            "tag": "proxy",
            "protocol": "vless",
            "settings": {
                "vnext": [
                    {
                        "address": "placeholder",
                        "port": 443,
                        "users": [
                            {
                                "id": "00000000-0000-0000-0000-000000000000",
                                "encryption": "none"
                            }
                        ]
                    }
                ]
            },
            "streamSettings": {
                "network": "ws",
                "security": "tls",
                "wsSettings": {
                    "path": "/admin"
                }
            }
        },
        {
            "tag": "direct",
            "protocol": "freedom"
        }
    ],
    "routing": {
        "domainStrategy": "AsIs",
        "rules": [
            {
                "type": "field",
                "ip": ["geoip:private", "geoip:cn"],
                "outboundTag": "direct"
            },
            {
                "type": "field",
                "domain": ["geosite:cn", "hub.hlwuxi.com"],
                "outboundTag": "direct"
            }
        ]
    }
}
