# Stage 2: Networking (Caddy & FRP)
FRP_SERVER=1.2.3.4
FRP_TOKEN=YOUR_FRP_TOKEN_HERE

# Stage 3: Registry and Puller (Local Mirroring)
# From public Docker Hub
DOCKER_HUB_USERNAME=clarexu
DOCKER_HUB_PASSWORD=YOUR_DOCKER_HUB_PASSWORD_HERE

# To Hlart Local Registry (hub.hlwuxi.com)
LOCAL_DOCKER_USERNAME=clare.xu@hlwuxi.com
LOCAL_DOCKER_PASSWORD=YOUR_LOCAL_DOCKER_PASSWORD_HERE

# Stage 3: Authentik (OIDC Provider)
AUTHENTIK_PG_PASS=YOUR_AUTHENTIK_PG_PASS_HERE
AUTHENTIK_SECRET_KEY=YOUR_AUTHENTIK_SECRET_KEY_HERE
AUTHENTIK_EMAIL_PASSWORD=YOUR_AUTHENTIK_EMAIL_PASSWORD_HERE

